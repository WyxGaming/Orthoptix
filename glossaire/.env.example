# Copiez en .env pour le développement local
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Google AdSense (optionnel — laisser vide pour désactiver les pubs)
# ID éditeur : ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT=
# Encart latéral rétractable (créer une unité « Display » verticale dans AdSense)
VITE_ADSENSE_SLOT_SIDEBAR=
# Pubs entre les sections alphabétiques (max 5 slots, séparés par des virgules)
# Créez 5 unités « Display » responsive dans AdSense, une par emplacement.
VITE_ADSENSE_SLOTS_INLINE=
