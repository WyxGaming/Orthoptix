{
  "name": "orthoptix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Serious game de bilan orthoptique sur patient virtuel 3D",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:april-model": "node scripts/prepare-april-model.mjs",
    "prepare:rihanna-model": "node scripts/prepare-rihanna-model.mjs",
    "prepare:lancaster-image": "node scripts/prepare-lancaster-image.mjs",
    "build:glossaire": "npm ci --prefix glossaire && npm run build --prefix glossaire",
    "build:pages:all": "npm run build:pages && npm run build:glossaire && mkdir -p dist/glossaire && cp -r glossaire/dist/* dist/glossaire/"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
